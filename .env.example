# Development-only local PostgreSQL cluster
DATABASE_URL=postgresql://admin@127.0.0.1:55432/data_agent
PORT=3000
APP_ENV=development
DEV_DEFAULT_TENANT_ID=11111111-1111-4111-8111-111111111111

# DeepSeek example. Do not commit a real API key.
MODEL_API_KEY=YOU_API_KEY
MODEL_BASE_URL=YOUR_BASE_URL

# Mem0 Platform is optional. When configured, it replaces PostgreSQL for
# long-term memory while PostgreSQL remains the event-log source of truth.
MEMORY_PROVIDER=mem0
MEM0_API_KEY=YOUR_MEM0_API_KEY
# MEM0_BASE_URL=https://api.mem0.ai
